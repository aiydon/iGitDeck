#!/usr/bin/env python3
"""Optional iGitDeck commit-msg hook: gitmoji + English type + Chinese description."""

from __future__ import annotations

import re
import sys
from pathlib import Path

TYPES = "feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
PATTERN = re.compile(rf"^(?:[:][a-z0-9_+-]+[:]|\S+)\s+(?:{TYPES})(?:\([^)]+\))?:\s+.+[\u4e00-\u9fff]")


def main() -> int:
    if len(sys.argv) != 2:
        return 0
    message = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
    first_line = message.splitlines()[0] if message.strip() else ""
    if first_line.startswith(("Merge ", "Revert ", "fixup!", "squash!")):
        return 0
    if PATTERN.search(first_line):
        return 0
    print(
        "commit-msg: 提交信息需为 gitmoji + 英文 type + 中文描述，例如：\n"
        "  :sparkles: feat(api): 增加仓库同步接口\n"
        "  ✨ feat(api): 增加仓库同步接口",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
