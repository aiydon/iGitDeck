# iGitDeck deployment configuration.
# All runtime data (repos, snapshots, sync logs) lives in SQLite under IGD_DATA_DIR.

# --- Web process -----------------------------------------------------------
# Bind address and port. Use 0.0.0.0 to expose the service to the intranet.
IGD_HOST=0.0.0.0
IGD_PORT=8000
IGD_DATA_DIR=./data
IGD_FRONTEND_DIST=./frontend/dist
IGD_LOG_LEVEL=INFO
# Logs live in IGD_DATA_DIR/logs; when a file passes this size it is compressed
# to a timestamped .gz backup and a fresh file is started.
IGD_LOG_MAX_BYTES=10485760
IGD_LOG_BACKUPS=5

# --- Sync scheduling -------------------------------------------------------
# Start the scheduler and sync newly added repositories immediately.
IGD_AUTO_SYNC=true
# Maximum number of repositories synced in parallel.
IGD_SYNC_CONCURRENCY=4
# Refresh a ready repository every N minutes.
IGD_SYNC_INTERVAL_MINUTES=60
# Failed repositories retry with exponential backoff starting here.
IGD_SYNC_RETRY_BASE_MINUTES=5
# ... capped at this delay.
IGD_SYNC_RETRY_MAX_MINUTES=120
# How often the scheduler looks for due repositories.
IGD_SCHEDULER_POLL_SECONDS=15
# Maximum repositories submitted per scheduler batch.
IGD_SYNC_BATCH_SIZE=32

# --- Git / code statistics -------------------------------------------------
# Hard cap for one git command.
IGD_GIT_TIMEOUT_SECONDS=3600
# Streamed clone/fetch is aborted only after this long without progress, so a
# slow multi-GB transfer can finish while a hang is still caught quickly.
IGD_GIT_IDLE_TIMEOUT_SECONDS=300
# Read-only smart HTTP (upload-pack) concurrency limit.
IGD_GIT_HTTP_CONCURRENCY=4
IGD_GIT_HTTP_TIMEOUT_SECONDS=1800
# Maximum compressed/decompressed upload-pack request body; larger requests get 413.
IGD_GIT_HTTP_MAX_REQUEST_BYTES=8388608
# scc binary. `make install` provides ./bin/scc on PATH; set an absolute path if desired.
IGD_SCC_BINARY=scc
IGD_SCC_TIMEOUT_SECONDS=600

# --- Metadata / README -----------------------------------------------------
# Best-effort GitHub API lookup for descriptions of manually added repositories.
IGD_FETCH_METADATA=true
IGD_METADATA_TIMEOUT_SECONDS=10
# Maximum README bytes read for display.
IGD_README_MAX_BYTES=1000000
# Maximum visible README characters indexed for FTS5.
IGD_README_INDEX_MAX_CHARS=200000
# Repositories with more commits than this scan only the newest N commits for
# trends/activity/churn/contributors; the chart is truncated, never blank.
IGD_GIT_INSIGHTS_MAX_COMMITS=100000

# --- Trending crawler (separate process: `make crawler`) -------------------
# Main-process base URL used by the crawler.
IGD_CRAWLER_API_BASE_URL=http://127.0.0.1:8000
# Seconds between crawler passes.
IGD_CRAWLER_INTERVAL_MINUTES=180
# daily | weekly | monthly
IGD_CRAWLER_SINCE=daily
# Comma-separated language slugs, e.g. python,rust,typescript. Empty = all languages.
IGD_CRAWLER_LANGUAGES=
# Maximum repositories submitted per trending feed.
IGD_CRAWLER_MAX_PER_FEED=25
# Timeout for GitHub Trending and POST calls made by the crawler.
IGD_CRAWLER_HTTP_TIMEOUT_SECONDS=30
